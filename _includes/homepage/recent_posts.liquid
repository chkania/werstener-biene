<!-- Recent Posts Section -->
    <section id="recent-posts" class="recent-posts section">

      <!-- Section Title -->
      <div class="container section-title" data-aos="fade-up">
        <h2>Letzte Beiträge</h2>
        <p>Die aktuellsten Informationen aus meiner Imkerei</p>
      </div><!-- End Section Title -->

      <div class="container">

        <div class="row gy-5">

          {% for post in site.posts limit: 4 %}
          <div class="col-xl-3 col-md-6">
            <div class="post-item position-relative h-100 d-flex flex-column" data-aos="fade-up" data-aos-delay="100">

              {% if post.teaser_image %}
              <div class="post-img position-relative overflow-hidden">
                {% picture startseite_recent_posts {{ post.teaser_image }} --alt Teaser Bild %}
                <span class="post-date">{{ post.date | date: "%d.%m.%Y"}}</span>
              </div>
              {% else %}
              <div class="post-date-inline">{{ post.date | date: "%d.%m.%Y"}}</div>
              {% endif %}

              <div class="post-content d-flex flex-column flex-grow-1">

                <h3 class="post-title">{{ post.title }}</h3>
                {% comment %}
                <div class="meta d-flex align-items-center">
                  <div class="d-flex align-items-center">
                    <i class="bi bi-person"></i> <span class="ps-2">Julia Parker</span>
                  </div>
                  <span class="px-3 text-black-50">/</span>
                  <div class="d-flex align-items-center">
                    <i class="bi bi-folder2"></i> <span class="ps-2">Politics</span>
                  </div>
                </div>
                {% endcomment %}

                <hr class="mt-auto">

                <a aria-label="Aufruf des Blogbeitrags {{ post.title }}" href="{{ post.url }}" class="readmore stretched-link"><span>Lesen</span><i class="bi bi-arrow-right"></i></a>

              </div>

            </div>
          </div><!-- End post item -->
    
            {% endfor %}

        </div>

      </div>

    </section><!-- /Recent Posts Section -->