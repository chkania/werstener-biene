---
---
[

  {% for post in site.posts %}
  {
    "title"    : "{{ post.title | strip_newlines | replace: "&shy;", ""  | escape }}",
    "category" : "{{ post.category }}",
    "tags"     : "{{ post.tags | join: ', ' | prepend: " " }}",
    "url"      : "{{ post.url | relative_url }}",
    "date"     : "{{ post.date | date: "%B %-d, %Y" }}",
    {% if post.excerpt != nil %}
    "excerpt"  : {{ post.excerpt | strip_html | jsonify }},
    {% else %}
    "excerpt"  : {{ post.content | strip_html | truncate: '250' | jsonify }},
    {% endif %}
  "content"  : {{ post.content | strip_html | escape | jsonify }}
} {% unless forloop.last %},{% endunless %}
  {% endfor %}

  {% if site.pages.size > 0 %},{% endif %}
  {% for page in site.pages %}
  {
  {% if page.title != nil and page.title != "Datenschutzerklärung" and page.title != "Impressum" and page.title != "Kontakt" %}
  "title"    : "{{ page.title | strip_newlines | replace: "&shy;", "" | escape }}",
  "category" : "{{ page.category }}",
  "tags"     : "{{ page.tags | join: ', ' | prepend: " " }}",
  "url"      : "{{ page.url | relative_url }}",
  "date"     : "{{ page.date | date: "%B %-d, %Y" }}",
  {% if page.excerpt != nil %}
  "excerpt"  : {{ page.excerpt | strip_html | jsonify }},
  {% else %}
  "excerpt"  : {{ page.content | strip_html | truncate: '250' | jsonify }},
  {% endif %}
  "content"  : {{ page.content | strip_html | escape | jsonify }}
  {% endif %}
} {% unless forloop.last %},{% endunless %}
  {% endfor %}

]
